{
  "name": "mupa-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.js",
    "dev:vite": "vite --port 5302",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "vite build --outDir dist/client && vite build --ssr src/entry-server.jsx --outDir dist/server && vite build --config vite.panel.config.js",
    "start": "node --env-file-if-exists=.env server/servidor.js",
    "migrar": "node --env-file-if-exists=.env server/db/migrar.js up",
    "migrar:atras": "node --env-file-if-exists=.env server/db/migrar.js down",
    "semilla:ejemplo": "node --env-file-if-exists=.env server/db/semillas/ejemplo.js",
    "crear-admin": "node --env-file-if-exists=.env server/scripts/admin.js crear",
    "restablecer-admin": "node --env-file-if-exists=.env server/scripts/admin.js restablecer",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"server/pruebas/**/*.test.js\""
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "~5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lenis": "^1.3.26",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "^6.0.1",
    "pdfjs-dist": "^5.7.284",
    "react-router": "^7.18.4",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.9"
  }
}
